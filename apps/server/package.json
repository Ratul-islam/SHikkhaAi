{
  "name": "@shikkha-ai/server",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && npm run copy:py-assets",
    "start": "node dist/server.js",
    "test": "vitest run",
    "verify:openrouter": "tsx scripts/verify-openrouter.ts",
    "verify:r2": "tsx scripts/verify-r2.ts",
    "migrate:media": "tsx scripts/migrate-media-to-r2.ts",
    "copy:py-assets": "mkdir -p dist/modules/video/manim && cp src/modules/video/manim/*.py dist/modules/video/manim/",
    "setup:manim": "tsx scripts/setup-manim.ts",
    "verify:manim": "tsx scripts/verify-manim.ts",
    "verify:pipeline": "tsx scripts/verify-lesson-pipeline.ts",
    "migrate:legacy-clips": "tsx scripts/migrate-legacy-clips.ts",
    "verify:ingestion": "tsx scripts/verify-ingestion.ts",
    "reset:content": "tsx scripts/reset-content.ts"
  },
  "dependencies": {
    "@andresaya/edge-tts": "^1.8.0",
    "@fastify/cookie": "^9.4.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/sensible": "^5.6.0",
    "@fastify/static": "^7.0.4",
    "@shikkha-ai/database": "*",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.1",
    "openai": "^4.56.0",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.15",
    "@types/nodemailer": "^8.0.1",
    "@types/pdf-parse": "^1.1.4",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^1.6.1"
  }
}
