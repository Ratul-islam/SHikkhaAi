DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
PORT=4000

# Generate strong random secrets for these — never commit real values.
JWT_ACCESS_SECRET="replace-with-a-strong-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-strong-random-secret"

# Google AI Studio (Gemini) key + its OpenAI-compatible endpoint, used for both
# gemini-embedding-001 (ingestion + chat query embedding, truncated to 768 dims)
# and gemini-3.6-flash chat completion (Phase 2). Never commit a real value.
OPENAI_API_KEY="replace-with-your-google-ai-studio-key"
OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"

# SMTP transport for verification + password-reset OTP emails (Phase 4).
# Any mailbox's SMTP works — e.g. a Gmail account with an App Password, or
# your own domain's mail provider. Never commit real values.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="replace-with-smtp-username"
SMTP_PASSWORD="replace-with-smtp-password"
SMTP_FROM="ShikkhaAI <no-reply@example.com>"

# Google OAuth (Phase 4) — from a Google Cloud OAuth 2.0 Client ID (Web
# application type). Redirect URI must be registered exactly as below in
# the Google Cloud Console.
#
# IMPORTANT: this points at the *frontend's* origin (port 3000), not the
# backend directly (port 4000) — apps/web/next.config.js rewrites /api/* to
# the backend, and the callback route sets the refresh-token cookie. Cookies
# only become first-party to the browser's later same-origin API calls (see
# auth.service.ts's comment on REFRESH_COOKIE_NAME) if Google's redirect — and
# therefore the Set-Cookie response — is proxied through that same origin.
# Pointing this at localhost:4000 directly would set a cookie the browser
# never attaches to its localhost:3000-proxied requests afterward.
GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/v1/auth/google/callback"

# GitHub OAuth (from a GitHub OAuth App, not a GitHub App) — same
# same-origin redirect-URI requirement as Google above.
GITHUB_CLIENT_ID="replace-with-github-oauth-client-id"
GITHUB_CLIENT_SECRET="replace-with-github-oauth-client-secret"
GITHUB_REDIRECT_URI="http://localhost:3000/api/v1/auth/github/callback"

# Where the OAuth callback redirects the browser back to after issuing
# tokens (the frontend origin).
WEB_APP_URL="http://localhost:3000"
