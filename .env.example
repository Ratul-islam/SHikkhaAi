# Used by docker-compose.yml for the Postgres+pgvector container
POSTGRES_USER=shikkha
POSTGRES_PASSWORD=changeme
POSTGRES_DB=shikkha_ai

# Copy this file to .env in the repo root (and/or apps/server/.env) and fill in real values.
# Never commit the real .env file.

# ── Lesson video rendering ────────────────────────────────────────────────
# Scenes are rendered locally by Manim and cost nothing. Set up the render
# environment once:  npm run setup:manim --workspace=apps/server
# then prove it:     npm run verify:manim --workspace=apps/server
#
# System packages it needs: ffmpeg, texlive + dvisvgm (for MathTex),
# fonts-noto-bengali (for Bangla labels). setup:manim reports any that are missing.

# "auto" (default) enables rendering once the boot health probe passes.
# "false" is the kill switch — every scene then degrades to a plain caption card.
MANIM_ENABLED=auto
# l = 480p15, m = 720p30 (default), h = 1080p60
MANIM_QUALITY=m
# Concurrent renders. This is the meter that binds now: rendering is free in
# dollars and expensive in CPU.
MANIM_MAX_CONCURRENT=2
# Address space per render, MB. NOT resident memory — a scene is ~380MB resident
# but reserves ~2.3GB of address space, and sizing this from RSS fails every
# render at shared-object mmap.
MANIM_MEMORY_MB=4096
MANIM_SCENE_TIMEOUT_MS=120000
# Retries after a rejected or crashed scene, with the error fed back. Cheap
# (~$0.001) and converts most mechanical failures into a rendered scene.
MANIM_MAX_RETRIES=1

# Lesson shape. The old 30-second ceiling existed only because footage cost
# $0.03/s; rendering is free, so a lesson can now run long enough to finish a
# concept.
VIDEO_MAX_SCENES=6
VIDEO_MAX_TOTAL_SEC=180

# ── Narration ─────────────────────────────────────────────────────────────
# With footage gone, TTS is ~90% of what a lesson costs.
#   edge   — free, and returns EXACT per-word timings (better beat alignment)
#   gemini — markedly better voice, ~$0.045 per 90s lesson, timings derived
# Switching to edge takes a new lesson from ~$0.05 to ~$0.005.
TTS_ENGINE=edge

# RETIRED, ignored if still set: VIDEO_GEN_ENABLED, VIDEO_GEN_MODEL,
# VIDEO_GEN_RESOLUTION — the paid veo/wan footage path no longer exists.
