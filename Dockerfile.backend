FROM python:3.14-slim

# Install system dependencies for Manim and Node.js
RUN apt-get update && apt-get install -y \
    curl \
    ffmpeg \
    libcairo2-dev \
    libpango1.0-dev \
    texlive \
    texlive-latex-extra \
    dvisvgm \
    build-essential \
    pkg-config \
    fontconfig \
    fonts-noto-core \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 20
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs

WORKDIR /app

# Manim render venv. The server spawns MANIM_PYTHON (default:
# apps/server/.venv-manim/bin/python, which only exists after a local
# `setup:manim`), so installing into the system python leaves the renderer
# unhealthy and every scene falls back to a caption card. Point it explicitly
# at a venv that lives outside /app, where `COPY . .` can't clobber it.
COPY apps/server/manim-requirements.txt ./
RUN python -m venv /opt/manim-venv && \
    /opt/manim-venv/bin/pip install --no-cache-dir -r manim-requirements.txt && \
    /opt/manim-venv/bin/python -I -c "import manim; print('manim', manim.__version__)"
ENV MANIM_PYTHON=/opt/manim-venv/bin/python

# Copy package.json files to cache npm install
COPY package.json package-lock.json ./
COPY apps/server/package.json apps/server/
COPY apps/web/package.json apps/web/
COPY packages/database/package.json packages/database/

# Install Node dependencies across the monorepo
RUN npm ci

# Copy the rest of the monorepo
COPY . .

# Generate Prisma client and build the backend server
RUN npm run prisma:generate --workspace=packages/database
RUN npm run build --workspace=packages/database
RUN npm run build --workspace=apps/server

# Set environment variables for production
ENV NODE_ENV=production
ENV PORT=4000

# Expose the backend port
EXPOSE 4000

# Start the Fastify backend
CMD ["npm", "run", "start", "--workspace=apps/server"]
